<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlanWise"
        android:usesCleartextTraffic="true">
        
        <!-- Dashboard Activity (Launcher) -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:theme="@style/Theme.PlanWise.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Plan Creation Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity"
            android:theme="@style/Theme.PlanWise" />
        
        <!-- Plan List Activity -->
        <activity
            android:name=".PlanListActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity"
            android:theme="@style/Theme.PlanWise" />
        
        <!-- Plan Detail Activity -->
        <activity
            android:name=".PlanDetailActivity"
            android:exported="false"
            android:parentActivityName=".PlanListActivity"
            android:theme="@style/Theme.PlanWise" />
        
        <!-- Plan Edit Activity -->
        <activity
            android:name=".PlanEditActivity"
            android:exported="false"
            android:parentActivityName=".PlanDetailActivity"
            android:theme="@style/Theme.PlanWise" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".DashboardActivity"
            android:theme="@style/Theme.PlanWise" />
        
    </application>

</manifest>